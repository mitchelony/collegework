{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build active C++ file",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compile the currently active C++ file"
        },
        {
            "label": "Run active C++ binary",
            "type": "shell",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "dependsOn": "Build active C++ file",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "detail": "Build then run the currently active C++ file"
        }
    ]
}